# Copy to .env and fill in. Never commit .env.

# Drive root (default matches this Mac when the volume is mounted)
MUSIC_DRIVE_ROOT=/Volumes/Will Hunter Music

# music-script (GetSongBPM) — https://getsongbpm.com/api
GETSONGBPM_API_KEY=

# library key correction (when recreated) — Spotify Developer Dashboard
# Rotate credentials if they were ever stored in plain text in old config.py
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: SoundCloud Go+ downloads (soundcloud_dl)
SOUNDCLOUD_AUTH_TOKEN=
