# Copy to .env and fill in. Never commit .env.

# Drive root — auto-detected from Scripts location (parent of this repo).
# Only set if Scripts is not on the music drive root, e.g.:
# MUSIC_DRIVE_ROOT=G:

# mashup-pop-finder: optional, only for --bpm-source getsongbpm
# GETSONGBPM_API_KEY=

# huntingszn-cover: SerpAPI Google Images (fetch / mashup)
# SERPAPI_API_KEY=

# huntingszn-cover: OpenAI images.edit (transform / mashup)
# OPENAI_API_KEY=

# library key correction (when recreated) — Spotify Developer Dashboard
# Rotate credentials if they were ever stored in plain text in old config.py
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: SoundCloud Go+ downloads (soundcloud_dl)
SOUNDCLOUD_AUTH_TOKEN=
